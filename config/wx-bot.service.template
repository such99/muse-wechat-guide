[Unit]
Description=wx-bot WeChat bridge (binding muse)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=8

[Service]
Type=simple
User=__USER__
Environment=HOME=__HOME__
EnvironmentFile=-__HOME__/.config/wx-bot/env
ExecStart=__HOME__/.local/bin/wx-bot run
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
